# Production Environment Variables - Backend (Example)
# انسخ هذا الملف إلى .env.production وعدل القيم

NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tam_gallery
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLIENT_ORIGIN=https://your-production-domain.com

# Hostinger SMTP — contact form notifications
EMAIL_USER=info@tamalarabiya.com
EMAIL_PASS=your_email_password_here
CONTACT_EMAIL_TO=info@tamalarabiya.com
